	title = {The physics of conformal radiotherapy: advances in technology ({PBK})},
	isbn = {978-0-367-80654-5},
	shorttitle = {The physics of conformal radiotherapy},
	abstract = {The Physics of Conformal Radiotherapy: Advances in Technology provides a thorough overview of conformal radiotherapy and biological modeling, focusing on the underlying physics and methodology of three-dimensional techniques in radiation therapy. This carefully written, authoritative account evaluates three-dimensional treatment planning, optimization, photon multileaf collimation, proton therapy, transit dosimetry, intensity-modulation techniques, and biological modeling. It is an invaluable teaching guide and reference for all medical physicists and radiation oncologists/therapists that use conformal radiotherapy},
	language = {eng},
	publisher = {CRC Press},
	author = {Webb, S.},
