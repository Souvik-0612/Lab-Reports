	file = {PDF:/Users/souvikdas/Zotero/storage/W3P8LTT8/Webb - 1997 - The physics of conformal radiotherapy advances in technology (PBK).pdf:application/pdf},
}

@book{metcalfe_physics_2023,
	address = {Madison},
	edition = {Third edition},
	title = {The physics of radiotherapy x-rays and electrons},
	isbn = {978-1-951134-10-5},
	abstract = {"Given the historical trial evidence, radiotherapy is a dominant therapeutic modality in the treatment of cancer. Globally, radiotherapy is a recommended treatment for 48\% of all cancer patients (Barton et al. 2014). Radiotherapy uses a medical linear accelerator, or linac. The physical properties and uses of various beams are discussed in this book. The book is designed primarily as a useful reference for radiation oncology physicists, whether in training or established in their careers. The material is also intended to be accessible to radiation oncologists, dosimetrists, and radiation therapists who wish to gain a deeper understanding of the physical principles behind the technology they interact with daily"--},
	publisher = {Medical Physics Publishing},
	author = {Metcalfe, Peter and Kron, Tomas and Hoban, Peter and Cutajar, Dean and Hardcastle, Nicholas},
	year = {2023},
	file = {PDF:/Users/souvikdas/Zotero/storage/G76DAVAR/Metcalfe et al. - 2023 - The physics of radiotherapy x-rays and electrons.pdf:application/pdf},
}
